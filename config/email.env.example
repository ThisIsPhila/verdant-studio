# Copy to ignored .local/mail.env (permissions 600); never paste secrets in chat.
# Transports: local_capture (files only), resend (provider delivery), icloud_smtp.
EMAIL_TRANSPORT=resend
# A sender on your verified Resend domain:
EMAIL_FROM_ADDRESS=verdant@thisisphila.co.za
EMAIL_FROM_NAME=Verdant
EMAIL_REPLY_TO=admin@thisisphila.co.za
EMAIL_BASE_URL=http://127.0.0.1:8088
# Administration origin for the storefront return link (unset hides the link):
ADMIN_BASE_URL=http://admin.verdant.localhost:8088
EMAIL_TEST_RECIPIENTS=admin@thisisphila.co.za,customer@thisisphila.co.za
# Delivery scope: 0 keeps the test allowlist above (recommended for development);
# 1 delivers to any valid recipient address (production behavior).
EMAIL_OPEN_DELIVERY=0
# Resend API key (re_...), from your Resend dashboard:
RESEND_API_KEY=
# Your full iCloud Mail login address and Apple-generated app-specific password:
ICLOUD_SMTP_USERNAME=
ICLOUD_SMTP_PASSWORD=

# Takes effect after starting the store with bin/mail-local.sh --store.
EMAIL_AUTO_QUEUE=1
