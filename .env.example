# Only local loopback development permits plain HTTP sessions. Use HTTPS in deployed environments.
APP_ENV=local
# Supply these through the process environment; PHP does not automatically load this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=verdant_dev
DB_USER=verdant_app
DB_PASSWORD=replace-with-a-local-password
# Optional Unix socket (DB_HOST=localhost); leave empty for TCP.
DB_SOCKET=

# Optional Paystack sandbox only. Copy a test key from the Paystack dashboard into ignored .env.
# Live keys are rejected by the application. Never commit any key.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:8088/payment/return
